<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Controlador.Ciudad.CiudadRegistrar"
            prefWidth="900" prefHeight="600"
            stylesheets="@../../Style/form.css">

    <AnchorPane style="-fx-background-color: #F4F6F9;"
                AnchorPane.topAnchor="0"
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0">

        <VBox alignment="CENTER" spacing="25"
              AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">

            <VBox spacing="20" alignment="CENTER"
                  maxWidth="550"
                  style="-fx-background-color: white;
                         -fx-padding: 35 45;
                         -fx-background-radius: 15;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5);">

                <!-- X DE CIERRE -->
                <HBox alignment="TOP_RIGHT">
                    <Button text="✖"
                            onAction="#volverAlMenuPrincipal"
                            style="-fx-background-color: transparent;
                                   -fx-font-size: 20px;
                                   -fx-font-weight: bold;
                                   -fx-text-fill: #444;
                                   -fx-cursor: hand;" />
                </HBox>

                <!-- TÍTULO -->
                <Label text="Registrar Ciudad"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #222;" />

                <GridPane hgap="25" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                        <ColumnConstraints halignment="LEFT" minWidth="250"/>
                    </columnConstraints>

                    <!-- ID CIUDAD -->
                    <Label text="ID Ciudad:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #444;" />
                    <TextField fx:id="txtIdCiudad" promptText="Ej: C001"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"
                               style="-fx-background-radius: 8; -fx-padding: 8 12;" />

                    <!-- NOMBRE CIUDAD -->
                    <Label text="Nombre Ciudad:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #444;" />
                    <TextField fx:id="txtNombreCiudad" promptText="Ej: Monterrey"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"
                               style="-fx-background-radius: 8; -fx-padding: 8 12;" />
                </GridPane>

                <!-- BOTONES -->
                <HBox spacing="20" alignment="CENTER">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>

                    <Button text="Guardar"
                            onAction="#guardarCiudad"
                            style="-fx-background-color: linear-gradient(to right, #007bff, #0056d2);
                                   -fx-text-fill: white;
                                   -fx-font-size: 15px;
                                   -fx-padding: 12 28;
                                   -fx-background-radius: 10;" />

                    <Button text="Limpiar"
                            onAction="#limpiar"
                            style="-fx-background-color: #6c757d;
                                   -fx-text-fill: white;
                                   -fx-padding: 12 28;
                                   -fx-font-size: 15px;
                                   -fx-background-radius: 10;" />
                </HBox>

            </VBox>
        </VBox>

    </AnchorPane>
</AnchorPane>
