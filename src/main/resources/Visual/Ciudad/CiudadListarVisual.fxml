<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Controlador.Ciudad.CiudadListar"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #F4F6F9;">

    <VBox spacing="20" alignment="TOP_CENTER"
          AnchorPane.topAnchor="30"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <!-- CARD DE TABLA -->
        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 15, 0, 0, 4);"
              maxWidth="850">

            <!-- X DE CIERRE -->
            <HBox alignment="TOP_RIGHT">
                <Button text="✖"
                        onAction="#volverAlMenuPrincipal"
                        style="-fx-background-color: transparent;
                               -fx-font-size: 20px;
                               -fx-font-weight: bold;
                               -fx-text-fill: #444;
                               -fx-cursor: hand;" />
            </HBox>

            <!-- TÍTULO -->
            <Label text="Listado de Ciudades"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #222;" />

            <!-- TABLA -->
            <TableView fx:id="tablaCiudades"
                       prefWidth="820"
                       style="-fx-background-radius: 10; -fx-padding: 10;">
                <columns>
                    <TableColumn fx:id="colId" text="ID Ciudad" prefWidth="150"/>
                    <TableColumn fx:id="colNombre" text="Nombre Ciudad" prefWidth="400"/>
                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="250"/>
                </columns>
            </TableView>

        </VBox>
    </VBox>

</AnchorPane>
