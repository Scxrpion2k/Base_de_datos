<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.base_de_datos.Controlador.Estadistica.EstadisticaEditar"
            fx:id="rootEditar"
            style="-fx-background-color: rgba(0,0,0,0.45);">

    <VBox alignment="CENTER"
          translateY="-70"
          translateX="-30"
          maxWidth="Infinity"
          maxHeight="Infinity"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <VBox spacing="18"
              alignment="TOP_CENTER"
              style="-fx-background-color: white;
                     -fx-background-radius: 18;
                     -fx-padding: 25;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 5);"
              maxWidth="450">

            <HBox alignment="CENTER_RIGHT" prefWidth="400">
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#cerrarVentana"
                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16"
                                 style="-fx-stroke: #444; -fx-stroke-width: 2;"/>
                    </graphic>
                </Button>
            </HBox>

            <Label text="Editar Estadística"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill:#222;"/>

            <VBox spacing="12" alignment="CENTER_LEFT" prefWidth="380">

                <Label text="ID Estadística" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtIdEstadistica"
                           promptText="ID Estadística"
                           style="-fx-background-radius: 10; -fx-padding: 8;"
                           disable="true"/>

                <Label text="Descripción" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtDescripcion"
                           promptText="Descripción"
                           style="-fx-background-radius: 10; -fx-padding: 8;"/>

                <Label text="Valor" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtValor"
                           promptText="Valor"
                           style="-fx-background-radius: 10; -fx-padding: 8;"/>

            </VBox>

            <HBox spacing="12" alignment="CENTER">

                <Button text="Guardar Cambios"
                        onAction="#guardarCambios"
                        style="-fx-background-color: #0d6efd;
                               -fx-text-fill:white;
                               -fx-background-radius: 10;
                               -fx-padding: 10 20;
                               -fx-font-weight: bold;"/>

                <Button text="Cancelar"
                        onAction="#cerrarVentana"
                        style="-fx-background-color: #dc3545;
                               -fx-text-fill:white;
                               -fx-background-radius: 10;
                               -fx-padding: 10 20;
                               -fx-font-weight: bold;"/>

            </HBox>

        </VBox>

    </VBox>

</AnchorPane>