<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="rootRegistrar" prefHeight="600" prefWidth="900" style="-fx-background-color: rgba(0,0,0,0.30);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.base_de_datos.Controlador.EstadisticaJuego.EstadisticaJuegoRegistrar">

    <VBox alignment="CENTER" spacing="30" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- CARD -->
        <VBox fx:id="cardFormulario" alignment="TOP_CENTER" maxWidth="550" spacing="25" style="-fx-background-color: white; -fx-padding: 35 45; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 18, 0, 0, 5);">

            <!-- BOTÓN X -->
            <HBox alignment="TOP_RIGHT">
                <Button onAction="#cerrarVentana" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16" style="-fx-stroke: #444; -fx-stroke-width: 2;" />
                    </graphic>
                </Button>
            </HBox>

            <!-- TÍTULO -->
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #222;" text="Registrar Estadística del Juego" />

            <!-- FORMULARIO -->
            <GridPane alignment="CENTER_LEFT" hgap="30" vgap="20" prefWidth="400">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150" prefWidth="150"/>
                    <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" minWidth="250" prefWidth="250"/>
                </columnConstraints>

                <!-- Juego -->
                <Label text="Juego:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtIdJuego" editable="false" prefHeight="30" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <!-- Estadística -->
                <Label text="Estadística:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbEstadistica" promptText="Seleccione Estadística" prefHeight="30" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <!-- Equipo -->
                <Label text="Equipo:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <ComboBox fx:id="cmbEquipo" promptText="Seleccione Equipo" prefHeight="30" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <!-- Jugador -->
                <Label text="Jugador:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbJugador" promptText="Seleccione Jugador" prefHeight="30" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <!-- Cantidad -->
                <Label text="Cantidad:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                <TextField fx:id="txtCantidad" promptText="Cantidad" prefHeight="30" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>
            </GridPane>

            <!-- BOTONES -->
            <HBox alignment="CENTER" spacing="25">
                <padding><Insets top="15" /></padding>

                <Button onAction="#guardarEstadistica" style="-fx-background-color: linear-gradient(to right, #007bff, #0056d2); -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 12 35; -fx-background-radius: 10; -fx-cursor: hand;" text="Guardar" />

                <Button onAction="#limpiar" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-padding: 12 35; -fx-font-size: 15px; -fx-background-radius: 10; -fx-cursor: hand;" text="Limpiar" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>
