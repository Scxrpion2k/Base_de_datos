<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="rootRegistrar"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Controlador.Estadistica.EstadisticaJuegoRegistrar"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: rgba(0,0,0,0.30);">

    <VBox alignment="CENTER" spacing="30"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <!-- CARD -->
        <VBox fx:id="cardFormulario"
              alignment="TOP_CENTER"
              spacing="25"
              maxWidth="550"
              style="-fx-background-color: white;
                     -fx-padding: 35 45;
                     -fx-background-radius: 18;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 18, 0, 0, 5);">

            <!-- BOTÓN X -->
            <HBox alignment="TOP_RIGHT">
                <Button onAction="#cerrarVentana"
                        style="-fx-background-color: transparent;
                               -fx-cursor: hand;
                               -fx-padding: 4;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16"
                                 style="-fx-stroke: #444;
                                        -fx-stroke-width: 2;" />
                    </graphic>
                </Button>
            </HBox>

            <!-- TÍTULO -->
            <Label text="Registrar Estadística del Juego"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #222;" />

            <!-- FORMULARIO -->
            <GridPane alignment="CENTER_LEFT" hgap="30" vgap="20">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="280" halignment="LEFT"/>
                </columnConstraints>

                <Label text="Juego:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtIdJuego" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Estadística:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbEstadistica" promptText="Seleccione Estadística" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Equipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbEquipo" promptText="Seleccione Equipo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Jugador:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbJugador" promptText="Seleccione Jugador" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Cantidad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCantidad" promptText="Cantidad" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- BOTONES -->
            <HBox alignment="CENTER" spacing="25">
                <padding><Insets top="15"/></padding>

                <Button text="Guardar"
                        onAction="#guardarEstadistica"
                        style="-fx-background-color: linear-gradient(to right, #007bff, #0056d2);
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-padding: 12 35;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>

                <Button text="Limpiar"
                        onAction="#limpiar"
                        style="-fx-background-color: #6c757d;
                               -fx-text-fill: white;
                               -fx-padding: 12 35;
                               -fx-font-size: 15px;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;"/>
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>
