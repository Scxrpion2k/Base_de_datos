<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="rootEditarJugador"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Controlador.Jugador.JugadorEditar"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: rgba(0,0,0,0.45);">

    <VBox alignment="CENTER"
          spacing="30"
          translateY="-70"
          AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <VBox fx:id="formularioEditar"
              spacing="25"
              alignment="TOP_CENTER"
              maxWidth="550"
              style="-fx-background-color: white;
                     -fx-padding: 35 45;
                     -fx-background-radius: 18;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 18, 0, 0, 5);">

            <HBox alignment="TOP_RIGHT">
                <Button onAction="#cerrarVentana"
                        style="-fx-background-color: transparent;
                               -fx-cursor: hand;
                               -fx-padding: 4;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16"
                                 style="-fx-stroke: #444;
                                        -fx-stroke-width: 2;" />
                    </graphic>
                </Button>
            </HBox>


            <Label text="Editar Jugador"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #222;" />

            <GridPane hgap="30" vgap="20" alignment="CENTER_LEFT">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="280" halignment="LEFT"/>
                </columnConstraints>

                <!-- ID -->
                <Label text="ID Jugador:"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;" />

                <TextField fx:id="txtIdJugador"
                           promptText="Ej: 01"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"
                           style="-fx-background-radius: 8;
                                  -fx-padding: 8 12;"
                           disable="true"/>

                <Label text="Nombre:"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;" />

                <TextField fx:id="txtNombre"
                           promptText="Ej: Carlos Méndez"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"
                           style="-fx-background-radius: 8;
                                  -fx-padding: 8 12;" />

                <Label text="Ciudad de Nacimiento:"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;" />

                <ComboBox fx:id="cmbCiudad"
                          prefWidth="240"
                          promptText="Seleccione ciudad"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"
                          style="-fx-background-radius: 8;
                                 -fx-padding: 6 10;" />

                <Label text="Fecha Nacimiento:"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;" />

                <DatePicker fx:id="dpFecha"
                            GridPane.rowIndex="3" GridPane.columnIndex="1"
                            style="-fx-background-radius: 8;
                                   -fx-padding: 6 10;" />

                <Label text="Número:"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;" />

                <TextField fx:id="txtNumero"
                           promptText="Ej: 23"
                           GridPane.rowIndex="4" GridPane.columnIndex="1"
                           style="-fx-background-radius: 8;
                                  -fx-padding: 8 12;" />

                <Label text="Equipo:"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;" />

                <ComboBox fx:id="cmbEquipo"
                          prefWidth="240"
                          promptText="Seleccione equipo"
                          GridPane.rowIndex="5" GridPane.columnIndex="1"
                          style="-fx-background-radius: 8;
                                 -fx-padding: 6 10;" />

            </GridPane>

            <HBox alignment="CENTER">
                <Button text="Guardar Cambios"
                        onAction="#guardarCambios"
                        style="-fx-background-color: linear-gradient(to right, #007bff, #0056d2);
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-padding: 12 35;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>