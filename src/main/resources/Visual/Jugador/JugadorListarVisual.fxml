<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Controlador.Jugador.JugadorListar"
            prefWidth="1250" prefHeight="750"
            style="-fx-background-color: #F4F6F9;">

    <VBox spacing="10" alignment="TOP_CENTER"
          AnchorPane.topAnchor="5"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <Label text="Listado de Jugadores"
               style="-fx-font-size: 34px;
                      -fx-font-weight: 700;
                      -fx-text-fill:#1F1F1F;" />

        <VBox spacing="18"
              prefWidth="1150"
              maxWidth="1150"
              style="-fx-background-color: white;
                     -fx-padding: 32;
                     -fx-background-radius: 18;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 20, 0, 0, 4);">


            <HBox alignment="CENTER_LEFT" spacing="15" prefWidth="1150">

                <Label text="Jugadores Registrados"
                       style="-fx-font-size: 22px;
                              -fx-font-weight: 600;
                              -fx-text-fill:#212121;" />

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnRegistrar"
                        text="➕ Registrar Jugador"
                        style="-fx-background-color:#0d6efd;
                               -fx-text-fill:white;
                               -fx-background-radius:10;
                               -fx-font-weight:bold;
                               -fx-padding:10 20;
                               -fx-cursor:hand;" />

                <Button fx:id="btnCerrar"
                        style="-fx-background-color:transparent; -fx-cursor:hand;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16"
                                 style="-fx-stroke:#444; -fx-stroke-width:2;" />
                    </graphic>
                </Button>

            </HBox>


            <TextField fx:id="txtBuscar"
                       promptText="Buscar jugador..."
                       prefWidth="300"
                       style="-fx-background-radius:10;
                              -fx-padding:10;
                              -fx-font-size:15px;
                              -fx-border-color:#C9C9C9;
                              -fx-border-radius:10;" />


            <TableView fx:id="tablaJugadores"
                       prefHeight="450"
                       maxHeight="450"
                       minHeight="350"
                       prefWidth="1100"
                       style="-fx-background-radius:12;
                              -fx-border-color:#D5D5D5;
                              -fx-border-width:1.2;
                              -fx-border-radius:12;
                              -fx-padding:5;">

                <columns>

                    <TableColumn fx:id="colId" text="ID" prefWidth="90"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="210"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                    <TableColumn fx:id="colCiudad" text="Ciudad Nac." prefWidth="180"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                    <TableColumn fx:id="colFecha" text="Fecha Nac." prefWidth="160"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                    <TableColumn fx:id="colNumero" text="Número" prefWidth="120"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                    <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="220"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                    <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="160"
                                 style="-fx-font-size:15px; -fx-font-weight:bold; -fx-alignment:CENTER;" />

                </columns>
            </TableView>

        </VBox>

    </VBox>

</AnchorPane>
