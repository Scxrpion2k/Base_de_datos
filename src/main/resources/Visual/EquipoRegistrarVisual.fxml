<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Logico.EquipoRegistrar"
            prefWidth="900" prefHeight="600">

    <VBox spacing="20" alignment="TOP_CENTER" AnchorPane.topAnchor="30" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">


        <Label text="Registrar Equipo"
               style="-fx-font-size: 26px; -fx-font-weight: bold;" />


        <GridPane hgap="15" vgap="20">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="150"/>
                <ColumnConstraints halignment="LEFT" minWidth="300"/>
            </columnConstraints>


            <Label text="ID Equipo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtIdEquipo" promptText="Ej: EQ001"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>


            <Label text="Nombre Equipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNombreEquipo" promptText="Ej: Tigres del Norte"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>


            <Label text="Ciudad:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbCiudad" prefWidth="200"
                      promptText="Seleccione una ciudad"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        </GridPane>


        <HBox spacing="20" alignment="CENTER">
            <Button text="Guardar" fx:id="btnGuardar"
                    onAction="#guardarEquipo"
                    style="-fx-background-color: #0084ff; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25;" />

            <Button text="Limpiar" fx:id="btnLimpiar"
                    onAction="#limpiar"
                    style="-fx-background-color: #999; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 25;" />
        </HBox>

    </VBox>

</AnchorPane>
