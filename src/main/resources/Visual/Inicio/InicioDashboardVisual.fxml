<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.base_de_datos.Controlador.Inicio.InicioDashboard"
            prefWidth="1400" prefHeight="800"
            style="-fx-background-color:#F4F6F9;">

    <VBox spacing="20" alignment="TOP_CENTER"
          AnchorPane.topAnchor="25"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <Label text="Últimos Juegos"
               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill:#1F1F1F;" />

        <FlowPane fx:id="panelJuegos"
                  hgap="20" vgap="20"
                  alignment="TOP_CENTER"
                  prefWidth="1300"
                  style="-fx-padding:20;">
        </FlowPane>

    </VBox>

</AnchorPane>
