<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.base_de_datos.Controlador.Inicio.InicioDashboard"
            prefWidth="1400" prefHeight="800"
            style="-fx-background-color:#F4F6F9;">

    <VBox spacing="25" alignment="TOP_CENTER"
          AnchorPane.topAnchor="20"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">

        <!-- 🔎 BUSCADOR CENTRADO -->
        <HBox alignment="CENTER" spacing="10">

            <TextField fx:id="txtBuscarJuego"
                       promptText="Buscar juego por ID (ej: 76)"
                       prefWidth="330"
                       style="
                       -fx-background-radius: 12;
                       -fx-font-size: 14px;
                       -fx-padding: 10 15;
                       -fx-border-color: #CFCFCF;
                       -fx-border-radius: 12;
                   "/>

            <Button fx:id="btnBuscarJuego"
                    text="Buscar"
                    style="
                    -fx-background-color: #0d6efd;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-background-radius: 12;
                    -fx-padding: 10 20;
                    -fx-cursor: hand;
                "/>
        </HBox>

        <!-- 🟦 CONTENEDOR DE LAS TARJETAS DE JUEGOS -->
        <FlowPane fx:id="panelJuegos"
                  hgap="20" vgap="20"
                  alignment="CENTER"
                  prefWidth="1000"
        />

    </VBox>

</AnchorPane>
