<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane fx:id="rootRegistrar"
            id="modalRegistrar"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.base_de_datos.Controlador.Equipo.EquipoRegistrar"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: rgba(0,0,0,0.30);">

    <VBox alignment="CENTER"
          spacing="30"
          translateY="-10"
          AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0">

        <VBox fx:id="cardFormulario"
              alignment="TOP_CENTER"
              maxWidth="550"
              spacing="25"
              style="-fx-background-color: white;
                     -fx-padding: 35 45;
                     -fx-background-radius: 18;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 18, 0, 0, 5);">

            <HBox alignment="TOP_RIGHT">
                <Button onAction="#volverAlMenuPrincipal"
                        style="-fx-background-color: transparent;
                               -fx-cursor: hand;
                               -fx-padding: 4;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16"
                                 style="-fx-stroke: #444;
                                        -fx-stroke-width: 2;" />
                    </graphic>
                </Button>
            </HBox>

            <Label text="Registrar Equipo"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #222;" />

            <GridPane alignment="CENTER_LEFT" hgap="30" vgap="20">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150" />
                    <ColumnConstraints halignment="LEFT" minWidth="280" />
                </columnConstraints>

                <Label text="ID Equipo:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;"/>

                <TextField fx:id="txtIdEquipo"
                           promptText="Ej: EQ001"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"
                           style="-fx-background-radius: 8;
                                  -fx-padding: 8 12;" />

                <Label text="Nombre del Equipo:"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;"/>

                <TextField fx:id="txtNombreEquipo"
                           promptText="Ej: Tigres del Norte"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-background-radius: 8;
                                  -fx-padding: 8 12;" />

                <Label text="Ciudad:"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"
                       style="-fx-font-size: 15px; -fx-text-fill: #444;"/>

                <ComboBox fx:id="cmbCiudad"
                          prefWidth="240"
                          promptText="Seleccione una ciudad"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"
                          style="-fx-background-radius: 8;
                                 -fx-padding: 6 10;" />

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER" spacing="25">
                <padding>
                    <Insets top="15" />
                </padding>

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        onAction="#guardarEquipo"
                        style="-fx-background-color: linear-gradient(to right, #007bff, #0056d2);
                               -fx-text-fill: white;
                               -fx-font-size: 15px;
                               -fx-padding: 12 35;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;" />

                <Button fx:id="btnLimpiar"
                        text="Limpiar"
                        onAction="#limpiar"
                        style="-fx-background-color: #6c757d;
                               -fx-text-fill: white;
                               -fx-padding: 12 35;
                               -fx-font-size: 15px;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>