<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane fx:id="rootReporte"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.base_de_datos.Controlador.EstadisticaJuego.EstadisticaJuegoReporte"
            style="-fx-background-color: rgba(0,0,0,0.40);">

    <VBox alignment="TOP_CENTER"
          spacing="20"
          prefWidth="1000" prefHeight="700"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- Tarjeta del reporte -->
        <VBox spacing="15"
              maxWidth="900"
              style="-fx-background-color: white;
                     -fx-background-radius: 18;
                     -fx-padding: 30;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0, 0, 5);">

            <!-- Botón cerrar -->
            <HBox alignment="TOP_RIGHT">
                <Button onAction="#cerrar"
                        style="-fx-background-color: transparent;
                               -fx-cursor: hand;">
                    <graphic>
                        <Label text="✖"
                               style="-fx-font-size:18px; -fx-text-fill:#333;"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- Encabezado -->
            <VBox alignment="CENTER" spacing="5">
                <Label fx:id="lblTitulo"
                       style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                <Label fx:id="lblFecha"
                       style="-fx-font-size: 18px; -fx-text-fill: #444;"/>
            </VBox>

            <!-- Tabla (scrollable y responsive) -->
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        style="-fx-background-color: transparent;">
                <TableView fx:id="tablaReporte"
                           columnResizePolicy="CONSTRAINED_RESIZE_POLICY"
                           style="-fx-font-size: 14px;">
                </TableView>
            </ScrollPane>

        </VBox>

    </VBox>

</AnchorPane>
