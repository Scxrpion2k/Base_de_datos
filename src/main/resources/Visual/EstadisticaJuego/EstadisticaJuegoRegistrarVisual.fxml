<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane fx:id="rootRegistrar"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.base_de_datos.Controlador.EstadisticaJuego.EstadisticaJuegoRegistrar"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: rgba(0,0,0,0.30);">

    <VBox alignment="CENTER" spacing="30"
          translateY="-70"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

        <VBox alignment="TOP_CENTER"
              spacing="25"
              maxWidth="550"
              style="-fx-background-color: white;
                     -fx-padding: 35 45;
                     -fx-background-radius: 18;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15),18,0,0,5);">


            <HBox alignment="TOP_RIGHT">
                <Button onAction="#cerrar"
                        style="-fx-background-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <SVGPath content="M4 4 L16 16 M16 4 L4 16"
                                 style="-fx-stroke:#444; -fx-stroke-width:2;" />
                    </graphic>
                </Button>
            </HBox>


            <Label text="Registrar Estadística del Juego"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill:#222;" />

            <GridPane hgap="25" vgap="20">

                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="150" />
                    <ColumnConstraints halignment="LEFT" minWidth="260" />
                </columnConstraints>

                <Label text="Juego:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="txtIdJuego"
                           editable="false"
                           style="-fx-background-radius:8; -fx-padding:8 12;
                                  -fx-opacity: 1; -fx-background-color: #E9ECEF;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" />


                <Label text="Equipo:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbEquipo"
                          promptText="Seleccione equipo"
                          prefWidth="240"
                          GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <!-- FILA 2: Jugador -->
                <Label text="Jugador:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbJugador"
                          promptText="Seleccione jugador"
                          prefWidth="240"
                          GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <!-- FILA 3: Estadística -->
                <Label text="Estadística:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <ComboBox fx:id="cmbEstadistica"
                          promptText="Seleccione estadística"
                          prefWidth="240"
                          GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <!-- FILA 4: Cantidad -->
                <Label text="Cantidad:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="txtCantidad"
                           promptText="Ej: 5"
                           style="-fx-background-radius:8; -fx-padding:8 12;"
                           GridPane.rowIndex="4" GridPane.columnIndex="1" />

            </GridPane>

            <!-- BOTONES -->
            <HBox alignment="CENTER" spacing="25">
                <Button text="Guardar"
                        onAction="#guardarEstadistica"
                        style="-fx-background-color:#28a745; -fx-text-fill:white;
                               -fx-padding:10 25; -fx-background-radius:10;" />

                <Button text="Limpiar"
                        onAction="#limpiar"
                        style="-fx-background-color:#6c757d; -fx-text-fill:white;
                               -fx-padding:10 25; -fx-background-radius:10;" />
            </HBox>

        </VBox>

    </VBox>

</AnchorPane>